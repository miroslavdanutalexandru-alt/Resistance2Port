{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "Resistance 2 Port",
    "repo": "miroslavdanutalexandru-alt/Resistance2Port",
    "saves": [
        "{install}/gamedata/dev_hdd0/home/00000001/savedata"
    ],
    "folders": {
        "saves": [
            {
                "path": "{install}/gamedata/dev_hdd0/home/00000001/savedata"
            }
        ],
        "logs": [
            {
                "path": "{install}/logs"
            }
        ]
    },
    "actions": [
        {
            "id": "saves",
            "label": "Saves",
            "help": "Your Resistance 2 save games.",
            "open": "saves"
        },
        {
            "id": "logs",
            "label": "Logs",
            "help": "The game's output log (run.log), useful when something goes wrong.",
            "open": "logs"
        }
    ]
}
